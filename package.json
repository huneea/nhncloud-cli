{
  "name": "@bifos/nhncloud-cli",
  "version": "0.20.0",
  "description": "CLI for NHN Cloud (Compute, Network, Kubernetes, Load Balancer, Log & Crash, Deploy, Secure Key Manager and more) — AI agent & terminal friendly",
  "keywords": [
    "nhncloud",
    "cli",
    "logncrash",
    "deploy",
    "nhn",
    "nhn-cloud",
    "openstack",
    "compute",
    "kubernetes",
    "nks",
    "load-balancer",
    "log-and-crash",
    "secure-key-manager",
    "ai-agent",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jon890/nhncloud-cli.git"
  },
  "homepage": "https://github.com/jon890/nhncloud-cli#readme",
  "bugs": {
    "url": "https://github.com/jon890/nhncloud-cli/issues"
  },
  "bin": {
    "nhncloud": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-package.mjs",
    "check:pii": "node scripts/check-pii.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/core": "^11.2.0",
    "@inquirer/prompts": "^8.5.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "ky": "^1.14.3",
    "ora": "^9.3.0",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
