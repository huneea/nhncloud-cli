{
  "name": "@bifos/nhncloud-cli",
  "version": "0.18.0",
  "description": "CLI tool for NHN Cloud services — AI agent & terminal friendly",
  "keywords": [
    "nhncloud",
    "cli",
    "logncrash",
    "deploy",
    "nhn"
  ],
  "bin": {
    "nhncloud": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/core": "^11.2.0",
    "@inquirer/prompts": "^8.5.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "ky": "^1.14.3",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
